<div class="row">
    <div class="col-md-4 mx-auto">
        <div class="card">
            <div class="card-header">
                Account register
            </div>
            <div class="card-body">
                <form action="/users/signup" method="POST">
                    <div class="form-group">
                        <input type="text" class="form-group" name="name1" placeholder="Ingrese Nombre" value="{{name1}}">
                    </div>
                    <div class="form-group">
                        <input type="email" class="form-group" name="email1" placeholder="Ingrese Gmail" value="{{email1}}">
                    </div>
                    <div class="form-group">
                        <input type="password" class="form-group" name="password1" placeholder="Ingrese Password" value="{{password1}}">
                    </div>
                    <div class="form-group">
                        <input type="password" class="form-group" name="confirm_password1"
                            placeholder="Confirm Password" value="{{confirm_password1}}">
                    </div>
                    <button class="btn btn-primary btn-block">
                        Enviar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>