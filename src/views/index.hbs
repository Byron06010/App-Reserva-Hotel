<link rel="stylesheet" href="https://cdn.datatables.net/1.10.2/css/jquery.dataTables.min.css">
<script type="text/javascript" src="https://cdn.datatables.net/1.10.2/js/jquery.dataTables.min.js"></script>
<div class="container">
    <div class="row justify-content-center">

<div class="card " style="width: 21rem; border-radius: 15px;">
    <img src="/img/hotel-app.jpg" class="card-img-top">
    <div class="card-body">
        <h5 class="card-title">Hotel-App</h5>
        <p class="card-text"> Bienvenido a Hotel-App una pagina web
            donde podras reservar en cualquier parte del mundo,con los mejores precios y la mejor
            disponibilidad.
        </p>
        <h4 class="card-title">inicia sesion para reservar</h4>
    </div>
</div>





{{#each notes}}
<tbody>

    <tr>
        <td>{{nombre}}</td>
        <td>{{direccion}}</td>
        <td>{{producto}}</td>
        <td>{{cantidad}}</td>
        <td>{{precio}}</td>
        <td>{{pago}}</td>
        <td>
            <form action="/notes/delete/{{_id}}?_method=DELETE" method="POST">
                <input type="hidden" name="_method" value="DELETE">
                <button type="submit" class="btn btn-danger btn-block btn-sm">Borrar</button>
            </form>
        </td>
        <td>
            <h4 class="justify-content-between -align-items-center">
                <a href="/notes/edit/{{_id}}"><i class="fa-solid fa-file-pen"></i></a>
        </td>
    </tr>
</tbody>
{{/each}}
</table>
</div>
</div>
</div>
</div><br><br><br><br>
